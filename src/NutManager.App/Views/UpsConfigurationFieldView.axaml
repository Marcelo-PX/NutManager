<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:NutManager.App.ViewModels"
             x:Class="NutManager.App.Views.UpsConfigurationFieldView"
             x:DataType="viewModels:UpsConfigurationFieldViewModel">
  <!--
    Compact form field: label, control, helper text. Fields are laid out in columns by the parent
    section, so this control adds no card of its own and no per-field surface nesting.
  -->
  <StackPanel Spacing="5" Width="248" Margin="0,0,16,14">
    <StackPanel Orientation="Horizontal" Spacing="6">
      <TextBlock Text="{Binding Label}" Classes="nut-label" TextWrapping="Wrap" />
      <PathIcon Data="{DynamicResource NutIconInfo}"
                Classes="muted"
                Width="12"
                Height="12"
                VerticalAlignment="Center"
                ToolTip.Tip="{Binding Help}"
                IsVisible="{Binding IsRisky}" />
    </StackPanel>

    <CheckBox Content="{Binding Strings[Ups.Editor.Enabled]}"
              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
              IsVisible="{Binding IsFlag}"
              AutomationProperties.Name="{Binding Label}" />

    <ComboBox ItemsSource="{Binding Choices}"
              SelectedValueBinding="{Binding TechnicalValue}"
              SelectedValue="{Binding DraftValue, Mode=TwoWay}"
              HorizontalAlignment="Stretch"
              IsVisible="{Binding HasChoices}"
              AutomationProperties.Name="{Binding Label}">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="viewModels:UpsFieldChoiceViewModel"><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>

    <!--
      Unit is rendered next to the input rather than inside it, keeping the stored value clean.

      Which of the two inputs appears is decided by the schema's declared field kind, never by the
      unit or the label: "seconds" sits on integers and on free text alike, and the driver directory
      would read as numeric to anything guessing from its neighbours. Numbers get the spinner; paths,
      hosts and commands keep the plain box they need.
    -->
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsValue}">
      <NumericUpDown Value="{Binding NumericValue, Mode=TwoWay}"
                     Minimum="{Binding Minimum}"
                     Maximum="{Binding Maximum}"
                     Increment="{Binding Increment}"
                     FormatString="{Binding NumericFormat}"
                     ParsingNumberStyle="Number"
                     IsVisible="{Binding IsNumeric}"
                     AutomationProperties.Name="{Binding Label}" />
      <TextBox Text="{Binding DraftValue, Mode=TwoWay}"
               IsVisible="{Binding IsFreeText}"
               AutomationProperties.Name="{Binding Label}" />
      <TextBlock Grid.Column="1"
                 Text="{Binding Unit}"
                 Classes="nut-metadata"
                 VerticalAlignment="Center"
                 IsVisible="{Binding Unit, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </Grid>

    <StackPanel IsVisible="{Binding IsSensitive}" Spacing="5">
      <TextBlock Text="{Binding SensitiveStateText}" Classes="nut-metadata" />
      <TextBox x:Name="SensitiveReplacementBox"
               PasswordChar="●"
               PlaceholderText="{Binding Strings[Ups.Editor.SecretReplacement]}"
               AutomationProperties.Name="{Binding Label}" />
      <WrapPanel>
        <Button Content="{Binding Strings[Ups.Editor.ReplaceSecret]}" Click="ReplaceSensitiveButton_OnClick" Margin="0,0,8,0" />
        <Button Classes="nut-danger" Content="{Binding Strings[Ups.Editor.Remove]}" Click="RemoveSensitiveButton_OnClick" IsVisible="{Binding IsSensitiveConfigured}" />
      </WrapPanel>
    </StackPanel>

    <Button Classes="nut-link"
            Content="{Binding AutomaticText}"
            Click="SetAutomaticButton_OnClick"
            IsVisible="{Binding SupportsAutomatic}"
            HorizontalAlignment="Left" />

    <TextBlock Text="{Binding Help}" Classes="nut-metadata" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
