<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:NutManager.App.ViewModels"
             xmlns:views="clr-namespace:NutManager.App.Views"
             x:Class="NutManager.App.Views.NutConfigurationAdministrationView"
             x:DataType="viewModels:AdministrationPageViewModel">
  <StackPanel Spacing="16">
    <Border Classes="nut-card" IsVisible="{Binding IsLocalManagementProfile}">
      <StackPanel Spacing="10">
        <TextBlock Text="{Binding Strings[Administration.Configuration.LocalInstallation]}" Classes="nut-section-title" />
        <TextBlock Text="{Binding InstallationStatusText}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <WrapPanel ItemWidth="280" ItemHeight="54">
          <StackPanel Margin="0,0,16,8"><TextBlock Text="{Binding Strings[Common.InstallationDirectory]}" Classes="nut-metadata" /><TextBlock Text="{Binding InstallationDirectoryText}" TextWrapping="Wrap" /></StackPanel>
          <StackPanel Margin="0,0,16,8"><TextBlock Text="{Binding Strings[Common.ConfigurationDirectory]}" Classes="nut-metadata" /><TextBlock Text="{Binding ConfigurationDirectoryText}" TextWrapping="Wrap" /></StackPanel>
          <StackPanel Margin="0,0,16,8"><TextBlock Text="{Binding Strings[Common.Version]}" Classes="nut-metadata" /><TextBlock Text="{Binding InstallationVersionText}" TextWrapping="Wrap" /></StackPanel>
        </WrapPanel>
        <WrapPanel>
          <Button Content="{Binding Strings[Common.RefreshDetection]}" Command="{Binding DetectInstallationCommand}" IsEnabled="{Binding CanChangeInstallation}" Margin="0,0,8,8" />
          <Button Content="{Binding Strings[Common.SelectFolder]}" Click="SelectDirectoryButton_OnClick" IsEnabled="{Binding CanChangeInstallation}" Margin="0,0,8,8" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border Classes="nut-card" IsVisible="{Binding IsRemoteManagementProfile}">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding Strings[Administration.Configuration.RemoteContext]}" Classes="nut-section-title" />
        <TextBlock Text="{Binding ManagementAvailabilityText}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Strings[Administration.Configuration.RemoteAccessHint]}" Classes="nut-metadata" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!--
      The file rail is a column that changes width, not a panel that is shown and hidden: the editor
      beside it simply gets the space back. Collapsing is presentation only, so the selected file,
      its draft and its editor are untouched by the fold.
    -->
    <Grid x:Name="ConfigurationEditorLayout" ColumnDefinitions="Auto,16,*" RowDefinitions="Auto" IsVisible="{Binding IsConfigurationEditorVisible}">
      <Border x:Name="ConfigurationFilesPanel"
              Grid.Column="0"
              Classes="nut-file-rail"
              VerticalAlignment="Top"
              Width="{Binding ConfigurationRailWidth}">
        <StackPanel Spacing="8">
          <!-- Title only when there is room for it; the toggle is always reachable. -->
          <!--
            The toggle sits on its own row above the title. Side by side, the title had to share
            228 px with a button and was permanently truncated to "Arquivos de configu…", which
            defeats the point of showing it at all.
          -->
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="1"
                       Grid.ColumnSpan="2"
                       Text="{Binding Strings[Administration.Configuration.Files]}"
                       Classes="nut-section-title"
                       IsVisible="{Binding IsConfigurationRailExpanded}"
                       Margin="2,2,0,0"
                       TextWrapping="Wrap" />
            <Button Grid.Row="0" Grid.Column="1"
                    Command="{Binding ToggleConfigurationRailCommand}"
                    AutomationProperties.Name="{Binding ConfigurationRailToggleText}"
                    ToolTip.Tip="{Binding ConfigurationRailToggleText}"
                    Padding="7"
                    MinWidth="0"
                    HorizontalAlignment="Right">
              <Panel Width="14" Height="14">
                <PathIcon Data="{DynamicResource NutIconChevronLeft}" Width="14" Height="14"
                          IsVisible="{Binding IsConfigurationRailExpanded}" />
                <PathIcon Data="{DynamicResource NutIconChevronRight}" Width="14" Height="14"
                          IsVisible="{Binding !IsConfigurationRailExpanded}" />
              </Panel>
            </Button>
          </Grid>

          <TextBlock Text="{Binding Strings[Administration.Configuration.NoFiles]}"
                     IsVisible="{Binding IsConfigurationFileListEmpty}"
                     Classes="nut-metadata"
                     TextWrapping="Wrap" />

          <ItemsControl ItemsSource="{Binding ConfigurationFiles}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="viewModels:NutConfigurationFileItemViewModel">
                <Button Classes="nut-file-rail-item"
                        Classes.selected="{Binding IsSelected}"
                        Click="ConfigurationFileRailItem_OnClick"
                        IsEnabled="{Binding CanLoad}"
                        AutomationProperties.Name="{Binding AccessibleName}"
                        ToolTip.Tip="{Binding AccessibleName}">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <!-- The icon pops once when the row becomes the selected one; nothing loops. -->
                    <Panel Width="18" Height="18" VerticalAlignment="Center"
                           Classes="nut-file-rail-icon"
                           DataContextChanged="ConfigurationFileRailIcon_OnAttached">
                      <PathIcon Data="{DynamicResource NutIconGeneral}" Width="18" Height="18" IsVisible="{Binding IsNutConf}" />
                      <PathIcon Data="{DynamicResource NutIconUps}" Width="18" Height="18" IsVisible="{Binding IsUpsConf}" />
                      <PathIcon Data="{DynamicResource NutIconServer}" Width="18" Height="18" IsVisible="{Binding IsUpsdConf}" />
                      <PathIcon Data="{DynamicResource NutIconUsers}" Width="18" Height="18" IsVisible="{Binding IsUpsdUsers}" />
                      <PathIcon Data="{DynamicResource NutIconMonitoring}" Width="18" Height="18" IsVisible="{Binding IsUpsmonConf}" />
                    </Panel>
                    <StackPanel Grid.Column="1"
                                Classes="nut-file-rail-label"
                                Spacing="1"
                                VerticalAlignment="Center"
                                IsVisible="{Binding $parent[ItemsControl].((viewModels:AdministrationPageViewModel)DataContext).IsConfigurationRailExpanded}">
                      <TextBlock Text="{Binding Category}" FontSize="13" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding FileName}" Classes="nut-metadata" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Ellipse Grid.Column="2"
                             Classes="nut-file-rail-dirty"
                             IsVisible="{Binding HasPendingChanges}"
                             ToolTip.Tip="{Binding StatusText}" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- The editor panel is a plain container: the form supplies its own sections, so nesting a
           card here would stack surfaces without adding hierarchy. -->
      <Border x:Name="ConfigurationEditorPanel" Grid.Column="2">
        <StackPanel Spacing="14">
          <StackPanel IsVisible="{Binding IsEditorPlaceholderVisible}" Spacing="4">
            <TextBlock Text="{Binding Strings[Administration.Configuration.NoSelection]}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Strings[Administration.Configuration.NoSelection.Help]}" Classes="nut-metadata" TextWrapping="Wrap" />
          </StackPanel>
          <!-- Shown in place of the editor while a file loads. The file list stays enabled behind
               it, so another file can be picked without waiting for this one. -->
          <StackPanel IsVisible="{Binding IsLoadingFile}" Spacing="8" Orientation="Horizontal">
            <TextBlock Text="{Binding SelectedFileName}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Strings[Administration.Configuration.Loading]}" Classes="nut-metadata" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Spacing="16" IsVisible="{Binding HasLoadedFile}">
            <!-- Breadcrumb and file header -->
            <StackPanel Spacing="10">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Title}" Classes="nut-metadata" />
                <PathIcon Data="{DynamicResource NutIconChevronRight}" Classes="muted" Width="10" Height="10" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Strings[Administration.Section.Configuration]}" Classes="nut-metadata" />
                <PathIcon Data="{DynamicResource NutIconChevronRight}" Classes="muted" Width="10" Height="10" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SelectedFileName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource NutTextPrimaryBrush}" />
              </StackPanel>

              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="13">
                <Border Width="40"
                        Height="40"
                        CornerRadius="10"
                        Background="{DynamicResource NutSurface2Brush}"
                        BorderBrush="{DynamicResource NutBorderSubtleBrush}"
                        BorderThickness="1">
                  <PathIcon Data="{DynamicResource NutIconGeneral}" Classes="accent" Width="19" Height="19" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding SelectedFileName}" FontSize="21" FontWeight="Bold" />
                  <TextBlock Text="{Binding SelectedFileStatusText}" Classes="nut-metadata" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding Strings[Common.Encoding]}" Classes="nut-metadata" />
                    <TextBlock Text="{Binding SelectedFileEncodingText}" FontSize="12.5" FontWeight="SemiBold" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </StackPanel>
            <ContentControl Content="{Binding UpsConfigurationEditor}" IsVisible="{Binding IsUpsConfigurationEditorVisible}" IsEnabled="{Binding CanEditEntries}">
              <ContentControl.DataTemplates>
                <DataTemplate DataType="viewModels:UpsConfigurationEditorViewModel"><views:UpsConfigurationEditorView /></DataTemplate>
              </ContentControl.DataTemplates>
            </ContentControl>
            <ContentControl Content="{Binding UpsdUsersConfigurationEditor}" IsVisible="{Binding IsUpsdUsersConfigurationEditorVisible}" IsEnabled="{Binding CanEditEntries}">
              <ContentControl.DataTemplates>
                <DataTemplate DataType="viewModels:UpsdUsersConfigurationEditorViewModel"><views:UpsdUsersConfigurationEditorView /></DataTemplate>
              </ContentControl.DataTemplates>
            </ContentControl>
            <ContentControl Content="{Binding UpsmonConfigurationEditor}" IsVisible="{Binding IsUpsmonConfigurationEditorVisible}" IsEnabled="{Binding CanEditEntries}">
              <ContentControl.DataTemplates>
                <DataTemplate DataType="viewModels:UpsmonConfigurationEditorViewModel"><views:UpsmonConfigurationEditorView /></DataTemplate>
              </ContentControl.DataTemplates>
            </ContentControl>
            <ContentControl Content="{Binding NutGeneralConfigurationEditor}" IsVisible="{Binding IsNutGeneralConfigurationEditorVisible}">
              <ContentControl.DataTemplates>
                <DataTemplate DataType="viewModels:NutGeneralConfigurationEditorViewModel"><views:NutGeneralConfigurationEditorView /></DataTemplate>
              </ContentControl.DataTemplates>
            </ContentControl>
            <ContentControl Content="{Binding UpsdConfigurationEditor}" IsVisible="{Binding IsUpsdConfigurationEditorVisible}">
              <ContentControl.DataTemplates>
                <DataTemplate DataType="viewModels:UpsdConfigurationEditorViewModel"><views:UpsdConfigurationEditorView /></DataTemplate>
              </ContentControl.DataTemplates>
            </ContentControl>
            <ItemsControl ItemsSource="{Binding Sections}" IsEnabled="{Binding CanEditEntries}" IsVisible="{Binding IsLegacyConfigurationEditorVisible}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="viewModels:NutConfigurationSectionViewModel">
                  <Expander Header="{Binding Name}" IsExpanded="True" Margin="0,4">
                    <StackPanel Spacing="9" Margin="0,8,0,0">
                      <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="viewModels:NutConfigurationEntryViewModel">
                            <Border Classes="nut-card-elevated" Padding="12" Margin="0,0,0,8">
                              <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                  <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding EntryTypeText}" Classes="nut-metadata" /></StackPanel>
                                  <TextBlock Grid.Column="1" Text="{Binding LineNumber}" Classes="nut-metadata" />
                                </Grid>
                                <TextBlock Text="{Binding SensitiveHint}" IsVisible="{Binding IsSensitive}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding InputLabel}" FontWeight="SemiBold" />
                                <TextBox Text="{Binding DraftValue, Mode=TwoWay}" IsVisible="{Binding IsNotSensitive}" TextWrapping="Wrap" />
                                <TextBox Text="{Binding DraftValue, Mode=TwoWay}" PasswordChar="●" IsVisible="{Binding IsSensitive}" TextWrapping="Wrap" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="{Binding RawContentSummary}" Classes="nut-metadata" TextWrapping="Wrap" />
                    </StackPanel>
                  </Expander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Action bar: pending state on the left, destructive and primary actions on the right. -->
            <Border Classes="nut-card-flat" Padding="13,11">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding HasDraftChanges}">
                  <PathIcon Data="{DynamicResource NutIconWarning}" Classes="warning" Width="15" Height="15" />
                  <TextBlock Text="{Binding Strings[Administration.Configuration.PendingChanges]}"
                             Classes="warning"
                             FontSize="13"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                </StackPanel>
                <WrapPanel Grid.Column="2" HorizontalAlignment="Right">
                  <Button Command="{Binding ReloadCommand}" IsEnabled="{Binding CanReload}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <PathIcon Classes="nut-icon-refresh" Data="{DynamicResource NutIconRefresh}" Width="15" Height="15" />
                      <TextBlock Text="{Binding Strings[Common.Reload]}" />
                    </StackPanel>
                  </Button>
                  <Button Classes="nut-danger" Command="{Binding DiscardCommand}" IsEnabled="{Binding CanDiscard}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <PathIcon Classes="nut-icon-delete" Data="{DynamicResource NutIconDelete}" Width="15" Height="15" />
                      <TextBlock Text="{Binding Strings[Common.DiscardChanges]}" />
                    </StackPanel>
                  </Button>
                  <Button Classes="nut-primary" Command="{Binding ReviewCommand}" IsEnabled="{Binding CanReview}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Strings[Common.ReviewChanges]}" />
                      <PathIcon Data="{DynamicResource NutIconForward}" Width="15" Height="15" />
                    </StackPanel>
                  </Button>
                </WrapPanel>
              </Grid>
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <Border Classes="nut-card-elevated" IsVisible="{Binding HasPreview}">
      <StackPanel Spacing="10">
        <TextBlock Text="{Binding Strings[Administration.Configuration.Review]}" Classes="nut-section-title" />
        <TextBlock Text="{Binding Strings[Administration.Configuration.Review.Help]}" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding PreviewLines}">
          <ItemsControl.ItemTemplate><DataTemplate x:DataType="viewModels:NutConfigurationPreviewLineViewModel"><Grid ColumnDefinitions="Auto,12,*,12,*" Margin="0,3"><TextBlock Text="{Binding LineNumber}" FontWeight="SemiBold" /><TextBlock Grid.Column="2" Text="{Binding OriginalText}" TextWrapping="Wrap" /><TextBlock Grid.Column="3" Text="→" HorizontalAlignment="Center" /><TextBlock Grid.Column="4" Text="{Binding CandidateText}" TextWrapping="Wrap" /></Grid></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <CheckBox Content="{Binding Strings[Administration.Configuration.ConfirmApply]}" IsChecked="{Binding IsPreviewConfirmed, Mode=TwoWay}" />
        <Button Classes="nut-success" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{DynamicResource NutIconCheck}" Width="15" Height="15" />
            <TextBlock Text="{Binding Strings[Administration.Configuration.Apply]}" />
          </StackPanel>
        </Button>
        <StackPanel Orientation="Horizontal" Spacing="9">
          <PathIcon Data="{DynamicResource NutIconShield}" Classes="muted" Width="14" Height="14" VerticalAlignment="Top" />
          <TextBlock Text="{Binding Strings[Administration.Configuration.BackupNotice]}" Classes="nut-metadata" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="nut-card" IsVisible="{Binding HasStatusMessage}">
      <StackPanel Spacing="7">
        <TextBlock Text="{Binding Strings[Common.Result]}" Classes="nut-section-title" />
        <TextBlock Text="{Binding CriticalResultText}" IsVisible="{Binding IsCriticalResult}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Strings[Common.Backup]}" IsVisible="{Binding HasBackupPath}" FontWeight="SemiBold" /><TextBlock Text="{Binding BackupPath}" IsVisible="{Binding HasBackupPath}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Strings[Common.Recovery]}" IsVisible="{Binding HasRecoveryPath}" FontWeight="SemiBold" /><TextBlock Text="{Binding RecoveryPath}" IsVisible="{Binding HasRecoveryPath}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Strings[Common.RemoteTemporary]}" IsVisible="{Binding HasTemporaryPath}" FontWeight="SemiBold" /><TextBlock Text="{Binding TemporaryPath}" IsVisible="{Binding HasTemporaryPath}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
