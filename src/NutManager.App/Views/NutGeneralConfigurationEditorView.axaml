<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:NutManager.App.ViewModels"
             xmlns:views="clr-namespace:NutManager.App.Views"
             x:Class="NutManager.App.Views.NutGeneralConfigurationEditorView"
             x:DataType="viewModels:NutGeneralConfigurationEditorViewModel">
  <StackPanel Spacing="14">
    <Border Classes="nut-card">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="3">
            <TextBlock Text="{Binding Strings[Config.General.Title]}" Classes="nut-section-title" />
            <TextBlock Text="{Binding Strings[Config.General.Description]}" Classes="nut-metadata" TextWrapping="Wrap" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" Content="{Binding Strings[Ups.Editor.AdvancedMode]}" IsChecked="{Binding ShowAdvanced, Mode=TwoWay}" />
        </Grid>
        <ItemsControl ItemsSource="{Binding BasicFields}">
          <ItemsControl.ItemTemplate><DataTemplate x:DataType="viewModels:ServerConfigurationFieldViewModel"><views:ServerConfigurationFieldView /></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding AdvancedFields}" IsVisible="{Binding ShowAdvanced}">
          <ItemsControl.ItemTemplate><DataTemplate x:DataType="viewModels:ServerConfigurationFieldViewModel"><views:ServerConfigurationFieldView /></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <views:ServerCustomParametersView DataContext="{Binding}" />
    <Border Classes="nut-card" IsVisible="{Binding HasValidationIssues}">
      <StackPanel Spacing="8"><TextBlock Text="{Binding Strings[Semantic.Validation.Title]}" Classes="nut-section-title" /><ItemsControl ItemsSource="{Binding ValidationIssues}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="viewModels:UpsValidationIssueViewModel"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
    </Border>
    <TextBlock Text="{Binding OperationMessage}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
