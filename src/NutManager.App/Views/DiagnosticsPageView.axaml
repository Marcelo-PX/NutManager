<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:NutManager.App.ViewModels"
             x:Class="NutManager.App.Views.DiagnosticsPageView"
             x:DataType="viewModels:DiagnosticsPageViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="20">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="6"><TextBlock Text="{Binding Title}" Classes="nut-page-title" /><TextBlock Text="{Binding Description}" MaxWidth="760" TextWrapping="Wrap" /></StackPanel>
        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Top">
          <Button Classes="nut-primary" Content="{Binding Strings[Diagnostics.Copy]}" Click="CopyDiagnosticsButton_OnClick" />
          <TextBlock Text="{Binding DiagnosticCopyStatusMessage}" IsVisible="{Binding HasDiagnosticCopyStatusMessage}" Classes="nut-metadata" TextWrapping="Wrap" MaxWidth="240" />
        </StackPanel>
      </Grid>

      <WrapPanel>
        <Border Classes="nut-card" Width="420" Margin="0,0,16,16">
          <StackPanel Spacing="10"><TextBlock Text="{Binding Strings[Diagnostics.Group.Overview]}" Classes="nut-section-title" /><TextBlock Text="{Binding ModeText}" FontWeight="SemiBold" /><WrapPanel><StackPanel Width="180" Margin="0,0,12,8"><TextBlock Text="{Binding Strings[Diagnostics.Application]}" Classes="nut-metadata" /><TextBlock Text="{Binding ApplicationName}" /></StackPanel><StackPanel Width="180" Margin="0,0,12,8"><TextBlock Text="{Binding Strings[Common.Version]}" Classes="nut-metadata" /><TextBlock Text="{Binding ApplicationVersion}" /></StackPanel><StackPanel Width="180" Margin="0,0,12,8"><TextBlock Text="{Binding Strings[Diagnostics.Runtime]}" Classes="nut-metadata" /><TextBlock Text="{Binding Runtime}" TextWrapping="Wrap" /></StackPanel><StackPanel Width="180" Margin="0,0,12,8"><TextBlock Text="{Binding Strings[Diagnostics.Architecture]}" Classes="nut-metadata" /><TextBlock Text="{Binding Architecture}" /></StackPanel></WrapPanel></StackPanel>
        </Border>

        <Border Classes="nut-card" Width="420" Margin="0,0,16,16">
          <StackPanel Spacing="10"><TextBlock Text="{Binding Strings[Diagnostics.Group.Connection]}" Classes="nut-section-title" /><WrapPanel><StackPanel Width="180" Margin="0,0,12,8"><TextBlock Text="{Binding Strings[Diagnostics.Profile]}" Classes="nut-metadata" /><TextBlock Text="{Binding ManagedProfileName}" TextWrapping="Wrap" /></StackPanel><StackPanel Width="180" Margin="0,0,12,8"><TextBlock Text="{Binding Strings[Common.State]}" Classes="nut-metadata" /><TextBlock Text="{Binding ConnectionStateText}" /></StackPanel><StackPanel Width="180" Margin="0,0,12,8"><TextBlock Text="{Binding Strings[Common.Host]}" Classes="nut-metadata" /><TextBlock Text="{Binding Host}" TextWrapping="Wrap" /></StackPanel><StackPanel Width="180" Margin="0,0,12,8"><TextBlock Text="{Binding Strings[Administration.Drivers.Port]}" Classes="nut-metadata" /><TextBlock Text="{Binding Port}" /></StackPanel></WrapPanel></StackPanel>
        </Border>

        <Border Classes="nut-card" Width="420" Margin="0,0,16,16">
          <StackPanel Spacing="10"><TextBlock Text="{Binding Strings[Diagnostics.Group.Polling]}" Classes="nut-section-title" /><WrapPanel><StackPanel Width="180" Margin="0,0,12,8"><TextBlock Text="{Binding Strings[Overview.Freshness]}" Classes="nut-metadata" /><TextBlock Text="{Binding DataFreshnessText}" /></StackPanel><StackPanel Width="180" Margin="0,0,12,8"><TextBlock Text="{Binding Strings[Diagnostics.Snapshot]}" Classes="nut-metadata" /><TextBlock Text="{Binding SnapshotStatusText}" /></StackPanel><StackPanel Width="180" Margin="0,0,12,8"><TextBlock Text="{Binding Strings[Diagnostics.Source]}" Classes="nut-metadata" /><TextBlock Text="{Binding DataSourceText}" /></StackPanel><StackPanel Width="180" Margin="0,0,12,8"><TextBlock Text="{Binding Strings[Overview.LastReading]}" Classes="nut-metadata" /><TextBlock Text="{Binding LastSuccessfulUpdateText}" /></StackPanel></WrapPanel></StackPanel>
        </Border>

        <Border Classes="nut-card" Width="420" Margin="0,0,16,16">
          <StackPanel Spacing="10"><TextBlock Text="{Binding Strings[Diagnostics.Group.Discovery]}" Classes="nut-section-title" /><WrapPanel><StackPanel Width="180" Margin="0,0,12,8"><TextBlock Text="{Binding Strings[Diagnostics.DiscoveredUps]}" Classes="nut-metadata" /><TextBlock Text="{Binding DiscoveredUpsCount}" /></StackPanel><StackPanel Width="180" Margin="0,0,12,8"><TextBlock Text="{Binding Strings[Diagnostics.SelectedUps]}" Classes="nut-metadata" /><TextBlock Text="{Binding SelectedUpsName}" TextWrapping="Wrap" /></StackPanel><StackPanel Width="180" Margin="0,0,12,8"><TextBlock Text="{Binding Strings[Overview.Manufacturer]}" Classes="nut-metadata" /><TextBlock Text="{Binding Manufacturer}" TextWrapping="Wrap" /></StackPanel><StackPanel Width="180" Margin="0,0,12,8"><TextBlock Text="{Binding Strings[Overview.Model]}" Classes="nut-metadata" /><TextBlock Text="{Binding Model}" TextWrapping="Wrap" /></StackPanel></WrapPanel></StackPanel>
        </Border>

        <Border Classes="nut-card" Width="420" Margin="0,0,16,16">
          <StackPanel Spacing="10"><TextBlock Text="{Binding Strings[Diagnostics.Group.Environment]}" Classes="nut-section-title" /><TextBlock Text="{Binding OperatingSystem}" TextWrapping="Wrap" /><TextBlock Text="{Binding LastErrorText}" TextWrapping="Wrap" /></StackPanel>
        </Border>
      </WrapPanel>

      <Border Classes="nut-card-elevated" IsVisible="{Binding IsLocalManagementProfile}">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="3"><TextBlock Text="{Binding Strings[Diagnostics.Group.Technical]}" Classes="nut-section-title" /><TextBlock Text="{Binding LocalInstallationStatusText}" FontWeight="SemiBold" /></StackPanel><WrapPanel Grid.Column="1"><Button Content="{Binding Strings[Common.RefreshDetection]}" Command="{Binding DetectLocalInstallationCommand}" IsEnabled="{Binding CanInspectLocalInstallation}" Margin="0,0,8,8" /><Button Content="{Binding Strings[Common.SelectFolder]}" Click="SelectDirectoryButton_OnClick" IsEnabled="{Binding CanInspectLocalInstallation}" Margin="0,0,8,8" /></WrapPanel></Grid>
          <WrapPanel><StackPanel Width="300" Margin="0,0,12,8"><TextBlock Text="{Binding Strings[Common.InstallationDirectory]}" Classes="nut-metadata" /><TextBlock Text="{Binding InstallationDirectoryText}" TextWrapping="Wrap" /></StackPanel><StackPanel Width="300" Margin="0,0,12,8"><TextBlock Text="{Binding Strings[Common.ConfigurationDirectory]}" Classes="nut-metadata" /><TextBlock Text="{Binding ConfigurationDirectoryText}" TextWrapping="Wrap" /></StackPanel><StackPanel Width="180" Margin="0,0,12,8"><TextBlock Text="{Binding Strings[Common.Version]}" Classes="nut-metadata" /><TextBlock Text="{Binding LocalInstallationVersionText}" /><TextBlock Text="{Binding LocalVersionSourceText}" Classes="nut-metadata" /></StackPanel><StackPanel Width="240" Margin="0,0,12,8"><TextBlock Text="{Binding Strings[Diagnostics.DetectionSource]}" Classes="nut-metadata" /><TextBlock Text="{Binding DetectionSourceText}" TextWrapping="Wrap" /></StackPanel></WrapPanel>
          <Expander Header="{Binding Strings[Diagnostics.Executables]}" IsExpanded="False"><TextBlock Text="{Binding ExecutablesText}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,8,0,0" /></Expander>
          <Expander Header="{Binding Strings[Diagnostics.ConfigurationFiles]}" IsExpanded="False"><TextBlock Text="{Binding ConfigurationFilesText}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,8,0,0" /></Expander>
          <TextBlock Text="{Binding LocalInstallationError}" IsVisible="{Binding HasLocalInstallationError}" TextWrapping="Wrap" Foreground="{DynamicResource NutCriticalBrush}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
