<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:NutManager.App.ViewModels"
             x:Class="NutManager.App.Views.DevicesPageView"
             x:DataType="viewModels:DevicesPageViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="20">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="6"><TextBlock Text="{Binding Title}" Classes="nut-page-title" /><TextBlock Text="{Binding Description}" MaxWidth="700" TextWrapping="Wrap" /></StackPanel>
        <Button Grid.Column="1" Classes="nut-primary" Content="{Binding Strings[Common.Refresh]}" Command="{Binding RefreshCommand}" IsEnabled="{Binding CanRefresh}" VerticalAlignment="Top" />
      </Grid>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsDiscovering}" Height="4" />
      <TextBlock Text="{Binding DiscoveryError}" IsVisible="{Binding HasDiscoveryError}" TextWrapping="Wrap" Foreground="{DynamicResource NutCriticalBrush}" />

      <Grid x:Name="DevicesLayout" ColumnDefinitions="260,16,*" RowDefinitions="Auto">
        <Border x:Name="DeviceListPanel" Grid.Column="0" Classes="nut-card">
          <StackPanel Spacing="10">
            <TextBlock Text="{Binding Strings[Devices.Available]}" Classes="nut-section-title" />
            <StackPanel IsVisible="{Binding HasNoDevices}" Spacing="4"><TextBlock Text="{Binding EmptyStateText}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Strings[Devices.EmptyHelp]}" Classes="nut-metadata" TextWrapping="Wrap" /></StackPanel>
            <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" SelectionChanged="OnDeviceSelectionChanged" IsVisible="{Binding HasDevices}">
              <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="5" Spacing="2"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" Classes="nut-metadata" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>

        <Border x:Name="DeviceDetailsPanel" Grid.Column="2" Classes="nut-card-elevated">
          <StackPanel Spacing="14">
            <StackPanel IsVisible="{Binding HasNoSelectedDevice}" Spacing="4"><TextBlock Text="{Binding Strings[Devices.NoSelection]}" FontWeight="SemiBold" /><TextBlock Text="{Binding Strings[Devices.NoSelection.Help]}" Classes="nut-metadata" TextWrapping="Wrap" /></StackPanel>
            <StackPanel Spacing="12" IsVisible="{Binding HasSelectedDevice}">
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding SelectedDeviceName}" Classes="nut-section-title" /><Border Grid.Column="1" IsVisible="{Binding IsSimulated}" Padding="8,4" CornerRadius="8" Background="{DynamicResource NutSelectionBrush}"><TextBlock Text="{Binding Strings[Shell.SimulationActive]}" FontWeight="SemiBold" /></Border></Grid>
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoadingDetails}" Height="4" />
              <TextBlock Text="{Binding DetailsError}" IsVisible="{Binding HasDetailsError}" TextWrapping="Wrap" Foreground="{DynamicResource NutCriticalBrush}" />
              <WrapPanel>
                <StackPanel Width="220" Margin="0,0,12,8"><TextBlock Text="{Binding Strings[Devices.Identity.Description]}" Classes="nut-metadata" /><TextBlock Text="{Binding SelectedDeviceDescription}" TextWrapping="Wrap" /></StackPanel>
                <StackPanel Width="180" Margin="0,0,12,8"><TextBlock Text="{Binding Strings[Devices.Identity.Manufacturer]}" Classes="nut-metadata" /><TextBlock Text="{Binding SelectedDeviceManufacturer}" TextWrapping="Wrap" /></StackPanel>
                <StackPanel Width="180" Margin="0,0,12,8"><TextBlock Text="{Binding Strings[Devices.Identity.Model]}" Classes="nut-metadata" /><TextBlock Text="{Binding SelectedDeviceModel}" TextWrapping="Wrap" /></StackPanel>
                <StackPanel Width="220" Margin="0,0,12,8"><TextBlock Text="{Binding Strings[Devices.Identity.Serial]}" Classes="nut-metadata" /><TextBlock Text="{Binding SelectedDeviceSerialNumber}" TextWrapping="Wrap" /></StackPanel>
              </WrapPanel>
              <TextBlock Text="{Binding Strings[Devices.RawVariables]}" Classes="nut-section-title" />
              <TextBlock Text="{Binding Strings[Devices.NoVariables]}" IsVisible="{Binding HasNoRawVariables}" Classes="nut-metadata" />
              <ItemsControl ItemsSource="{Binding RawVariables}" IsVisible="{Binding HasRawVariables}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="220,12,*" Margin="0,3"><TextBlock Text="{Binding Name}" FontFamily="Consolas" FontWeight="SemiBold" /><TextBlock Grid.Column="2" Text="{Binding Value}" FontFamily="Consolas" TextWrapping="Wrap" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
