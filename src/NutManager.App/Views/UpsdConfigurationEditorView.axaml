<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:NutManager.App.ViewModels"
             xmlns:views="clr-namespace:NutManager.App.Views"
             x:Class="NutManager.App.Views.UpsdConfigurationEditorView"
             x:DataType="viewModels:UpsdConfigurationEditorViewModel">
  <!-- Shares the ups.conf composition language: sectioned headers over field columns. -->
  <StackPanel Spacing="18">
    <StackPanel Spacing="3">
      <TextBlock Text="{Binding Strings[Config.Server.Title]}" Classes="nut-card-title" />
      <TextBlock Text="{Binding Strings[Config.Server.Description]}" Classes="nut-metadata" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Spacing="0">
      <StackPanel Orientation="Horizontal">
        <Button Classes="nut-tab"
                Classes.selected="{Binding !ShowAdvanced}"
                Click="ShowBasicButton_OnClick"
                Content="{Binding Strings[Ups.Editor.Basic]}"
                AutomationProperties.Name="{Binding Strings[Ups.Editor.Basic]}" />
        <Button Classes="nut-tab"
                Classes.selected="{Binding ShowAdvanced}"
                Click="ShowAdvancedButton_OnClick"
                Content="{Binding Strings[Ups.Editor.AdvancedMode]}"
                AutomationProperties.Name="{Binding Strings[Ups.Editor.AdvancedMode]}" />
      </StackPanel>
      <Border Classes="nut-divider" />
    </StackPanel>

    <Border Classes="nut-card">
      <StackPanel Spacing="18">
      <!-- ==================== Repeated LISTEN rows ==================== -->
      <StackPanel Spacing="10">
      <StackPanel Orientation="Horizontal" Spacing="9">
        <PathIcon Data="{DynamicResource NutIconNetwork}" Classes="cyan" Width="16" Height="16" />
        <TextBlock Text="{Binding Strings[Config.Listen.Title]}" Classes="nut-card-title" VerticalAlignment="Center" />
      </StackPanel>
      <Border Classes="nut-divider" />
      <TextBlock Text="{Binding Strings[Config.Listen.SecurityHelp]}" Classes="nut-metadata" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Strings[Config.Listen.Empty]}" Classes="nut-metadata" IsVisible="{Binding HasNoListeners}" TextWrapping="Wrap" />

      <ItemsControl ItemsSource="{Binding Listeners}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="viewModels:UpsdListenRowViewModel">
            <Border Classes="nut-card-flat" Padding="12,10" Margin="0,0,0,8">
              <Grid ColumnDefinitions="*,110,Auto,Auto" ColumnSpacing="9">
                <TextBox Text="{Binding Address, Mode=TwoWay}"
                         IsReadOnly="{Binding !CanEdit}"
                         AutomationProperties.Name="{Binding Strings[Config.Listen.Address]}" />
                <TextBox Grid.Column="1"
                         Text="{Binding PortText, Mode=TwoWay}"
                         IsReadOnly="{Binding !CanEdit}"
                         AutomationProperties.Name="{Binding Strings[Config.Listen.OptionalPort]}" />
                <Button Grid.Column="2" Command="{Binding SaveCommand}" IsEnabled="{Binding CanEdit}"
                        ToolTip.Tip="{Binding Strings[Config.Listen.Save]}"
                        AutomationProperties.Name="{Binding Strings[Config.Listen.Save]}">
                  <PathIcon Data="{DynamicResource NutIconCheck}" Width="14" Height="14" />
                </Button>
                <Button Grid.Column="3" Classes="nut-danger" Command="{Binding RemoveCommand}" IsEnabled="{Binding CanEdit}"
                        ToolTip.Tip="{Binding Strings[Config.Listen.Remove]}"
                        AutomationProperties.Name="{Binding Strings[Config.Listen.Remove]}">
                  <PathIcon Classes="nut-icon-delete" Data="{DynamicResource NutIconDelete}" Width="14" Height="14" />
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Grid ColumnDefinitions="*,110,Auto" ColumnSpacing="9" IsVisible="{Binding CanEdit}">
        <TextBox Text="{Binding NewListenAddress, Mode=TwoWay}" PlaceholderText="{Binding Strings[Config.Listen.Address]}" />
        <TextBox Grid.Column="1" Text="{Binding NewListenPort, Mode=TwoWay}" PlaceholderText="{Binding Strings[Config.Listen.OptionalPort]}" />
        <Button Grid.Column="2" Command="{Binding AddListenerCommand}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <PathIcon Classes="nut-icon-add" Data="{DynamicResource NutIconAdd}" Width="14" Height="14" />
            <TextBlock Text="{Binding Strings[Config.Listen.Add]}" />
          </StackPanel>
        </Button>
      </Grid>
      </StackPanel>

      <!-- ==================== Server behavior ==================== -->
      <StackPanel Spacing="10">
      <StackPanel Orientation="Horizontal" Spacing="9">
        <PathIcon Data="{DynamicResource NutIconServer}" Classes="accent" Width="16" Height="16" />
        <TextBlock Text="{Binding Strings[Config.Server.Behavior]}" Classes="nut-card-title" VerticalAlignment="Center" />
      </StackPanel>
      <Border Classes="nut-divider" />
      <ItemsControl ItemsSource="{Binding BasicFields}" IsVisible="{Binding !ShowAdvanced}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="viewModels:ServerConfigurationFieldViewModel"><views:ServerConfigurationFieldView /></DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ItemsControl ItemsSource="{Binding AdvancedFields}" IsVisible="{Binding ShowAdvanced}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="viewModels:ServerConfigurationFieldViewModel"><views:ServerConfigurationFieldView /></DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </StackPanel>

      <!-- ==================== TLS / certificates ==================== -->
      <StackPanel Spacing="10" IsVisible="{Binding HasTlsFields}">
      <StackPanel Orientation="Horizontal" Spacing="9">
        <PathIcon Data="{DynamicResource NutIconTls}" Classes="warning" Width="16" Height="16" />
        <TextBlock Text="{Binding Strings[Config.Tls.Title]}" Classes="nut-card-title" VerticalAlignment="Center" />
      </StackPanel>
      <Border Classes="nut-divider" />
      <TextBlock Text="{Binding Strings[Config.Tls.BackendHelp]}" Classes="nut-metadata" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding TlsFields}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="viewModels:ServerConfigurationFieldViewModel"><views:ServerConfigurationFieldView /></DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Change-only CERTIDENT: values are captured at the view boundary and never projected back. -->
      <Border Classes="nut-card-flat" Padding="12,11" IsVisible="{Binding CanEdit}">
        <StackPanel Spacing="9">
          <TextBlock Text="{Binding Strings[Config.Tls.CertificateIdentity.ChangeOnly]}" Classes="nut-metadata" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="9">
            <TextBox x:Name="CertificateIdentityBox"
                     PlaceholderText="{Binding Strings[Config.Tls.CertificateIdentity]}"
                     AutomationProperties.Name="{Binding Strings[Config.Tls.CertificateIdentity]}" />
            <TextBox x:Name="CertificatePasswordBox"
                     Grid.Column="1"
                     PasswordChar="●"
                     PlaceholderText="{Binding Strings[Config.Tls.Password]}"
                     AutomationProperties.Name="{Binding Strings[Config.Tls.Password]}" />
            <Button Grid.Column="2" Content="{Binding Strings[Config.Tls.ReplaceIdentity]}" Click="ReplaceCertificateIdentity_OnClick" />
            <Button Grid.Column="3" Classes="nut-danger" Content="{Binding Strings[Config.Tls.RemoveIdentity]}" Click="RemoveCertificateIdentity_OnClick" />
          </Grid>
        </StackPanel>
      </Border>
      </StackPanel>
      </StackPanel>
    </Border>

    <views:ServerCustomParametersView DataContext="{Binding}" />

    <Border Classes="nut-card" IsVisible="{Binding HasValidationIssues}" BorderBrush="{DynamicResource NutWarningBrush}">
      <StackPanel Spacing="7">
        <StackPanel Orientation="Horizontal" Spacing="9">
          <PathIcon Data="{DynamicResource NutIconWarning}" Classes="warning" Width="15" Height="15" />
          <TextBlock Text="{Binding Strings[Semantic.Validation.Title]}" Classes="nut-card-title" VerticalAlignment="Center" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding ValidationIssues}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="viewModels:UpsValidationIssueViewModel">
              <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Classes="warning" FontSize="12.5" Margin="0,2" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <TextBlock Text="{Binding OperationMessage}" Classes="nut-metadata" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
