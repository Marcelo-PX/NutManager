<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:NutManager.App.ViewModels"
             xmlns:views="clr-namespace:NutManager.App.Views"
             x:Class="NutManager.App.Views.UpsConfigurationEditorView"
             x:DataType="viewModels:UpsConfigurationEditorViewModel">
  <StackPanel Spacing="16">
    <Border Classes="nut-card-elevated">
      <StackPanel Spacing="10">
        <TextBlock Text="{Binding Strings[Ups.Editor.Title]}" Classes="nut-section-title" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <ComboBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection, Mode=TwoWay}" MinWidth="220"
                    AutomationProperties.Name="{Binding Strings[Ups.Editor.SelectedUps]}" />
          <WrapPanel Grid.Column="1">
            <TextBox Text="{Binding NewSectionName, Mode=TwoWay}" PlaceholderText="{Binding Strings[Ups.Editor.NewUpsName]}" Width="150" Margin="0,0,8,8"
                     AutomationProperties.Name="{Binding Strings[Ups.Editor.NewUpsName]}" />
            <Button Content="{Binding Strings[Ups.Editor.AddUps]}" Command="{Binding AddSectionCommand}" Margin="0,0,8,8" />
          </WrapPanel>
        </Grid>
        <WrapPanel IsVisible="{Binding HasSections}">
          <TextBox Text="{Binding RenameSectionName, Mode=TwoWay}" Width="180" Margin="0,0,8,8"
                   AutomationProperties.Name="{Binding Strings[Ups.Editor.RenameUpsName]}" />
          <Button Content="{Binding Strings[Ups.Editor.Rename]}" Command="{Binding RenameSectionCommand}" Margin="0,0,8,8" />
          <Button Classes="nut-danger" Content="{Binding Strings[Ups.Editor.RemoveUps]}" Command="{Binding RemoveSectionCommand}" Margin="0,0,8,8" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border Classes="nut-card" IsVisible="{Binding HasGlobalFields}">
      <StackPanel Spacing="10">
        <TextBlock Text="{Binding Strings[Ups.Editor.GlobalOptions]}" Classes="nut-section-title" />
        <ItemsControl ItemsSource="{Binding GlobalFields}">
          <ItemsControl.ItemTemplate><DataTemplate x:DataType="viewModels:UpsConfigurationFieldViewModel"><views:UpsConfigurationFieldView /></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <StackPanel Spacing="14" IsVisible="{Binding HasSections}">
      <StackPanel Spacing="14">
        <Border Classes="nut-card">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding Strings[Ups.Editor.DriverAndParameters]}" Classes="nut-section-title" />
                <TextBlock Text="{Binding SelectedDriverDescription}" Classes="nut-metadata" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SelectedDriverAvailability}" Classes="nut-metadata" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" Content="{Binding Strings[Ups.Editor.AdvancedMode]}" IsChecked="{Binding ShowAdvanced, Mode=TwoWay}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding BasicFields}">
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="viewModels:UpsConfigurationFieldViewModel"><views:UpsConfigurationFieldView /></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding AdvancedFields}" IsVisible="{Binding ShowAdvanced}">
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="viewModels:UpsConfigurationFieldViewModel"><views:UpsConfigurationFieldView /></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <StackPanel Spacing="14">
          <Border Classes="nut-card" IsVisible="{Binding IsRuntimeCalibrationAvailable}">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding Strings[Ups.Runtimecal.Title]}" Classes="nut-section-title" />
              <TextBlock Text="{Binding Strings[Ups.Runtimecal.Explanation]}" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                <StackPanel><TextBlock Text="{Binding Strings[Ups.Runtimecal.HighRuntime]}" /><NumericUpDown Value="{Binding RuntimeHighSeconds, Mode=TwoWay}" Minimum="1" /></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="{Binding Strings[Ups.Runtimecal.HighLoad]}" /><NumericUpDown Value="{Binding RuntimeHighLoad, Mode=TwoWay}" Minimum="1" Maximum="100" /></StackPanel>
                <StackPanel Grid.Row="1"><TextBlock Text="{Binding Strings[Ups.Runtimecal.LowRuntime]}" /><NumericUpDown Value="{Binding RuntimeLowSeconds, Mode=TwoWay}" Minimum="1" /></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="{Binding Strings[Ups.Runtimecal.LowLoad]}" /><NumericUpDown Value="{Binding RuntimeLowLoad, Mode=TwoWay}" Minimum="1" Maximum="100" /></StackPanel>
              </Grid>
              <TextBlock Text="{Binding Strings[Ups.Runtimecal.Safety]}" Classes="nut-metadata" TextWrapping="Wrap" />
              <Button Classes="nut-primary" Content="{Binding Strings[Ups.Runtimecal.UseDraft]}" Command="{Binding UseRuntimeCalibrationCommand}" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>

          <Border Classes="nut-card" IsVisible="{Binding HasUnsupportedFields}">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding Strings[Ups.Editor.UnsupportedTitle]}" Classes="nut-section-title" />
              <TextBlock Text="{Binding Strings[Ups.Editor.UnsupportedHelp]}" Classes="nut-metadata" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding UnsupportedFields}">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="viewModels:UpsConfigurationFieldViewModel"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>

      <Border Classes="nut-card">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding Strings[Semantic.Custom.Title]}" Classes="nut-section-title" />
          <TextBlock Text="{Binding Strings[Semantic.Custom.LimitedValidation]}" Classes="nut-metadata" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding CustomParameters}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="viewModels:UpsCustomParameterViewModel">
                <Grid ColumnDefinitions="180,*,Auto" ColumnSpacing="10" Margin="0,3">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="{Binding SafeValue}" TextWrapping="Wrap" />
                  <Button Grid.Column="2" Classes="nut-danger" Content="{Binding RemoveText}" Click="RemoveCustomButton_OnClick" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid ColumnDefinitions="180,*,Auto" ColumnSpacing="10">
            <TextBox Text="{Binding NewCustomName, Mode=TwoWay}" PlaceholderText="{Binding Strings[Ups.Editor.NutKey]}" />
            <TextBox Grid.Column="1" Text="{Binding NewCustomValue, Mode=TwoWay}" PlaceholderText="{Binding Strings[Ups.Editor.Value]}" />
            <Button Grid.Column="2" Content="{Binding Strings[Semantic.Operation.AddCustomParameter]}" Command="{Binding AddCustomParameterCommand}" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="nut-card" IsVisible="{Binding HasValidationIssues}">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding Strings[Semantic.Validation.Title]}" Classes="nut-section-title" />
          <ItemsControl ItemsSource="{Binding ValidationIssues}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="viewModels:UpsValidationIssueViewModel"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2" /></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <TextBlock Text="{Binding OperationMessage}" TextWrapping="Wrap" />
    </StackPanel>
  </StackPanel>
</UserControl>
