<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:NutManager.App.ViewModels"
             xmlns:views="clr-namespace:NutManager.App.Views"
             x:Class="NutManager.App.Views.AdministrationPageView"
             x:DataType="viewModels:AdministrationPageViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="20">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding Title}" Classes="nut-page-title" />
        <TextBlock Text="{Binding Description}" MaxWidth="900" TextWrapping="Wrap" />
      </StackPanel>

      <Border Classes="nut-card">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="3">
              <TextBlock Text="{Binding Strings[Administration.Context.Title]}" Classes="nut-section-title" />
              <TextBlock Text="{Binding ManagedProfileName}" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Text="{Binding AdministrationAvailabilityText}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
          </Grid>
          <WrapPanel ItemWidth="220" ItemHeight="52">
            <StackPanel Margin="0,0,16,8">
              <TextBlock Text="{Binding Strings[Administration.Context.Endpoint]}" Classes="nut-metadata" />
              <TextBlock Text="{Binding ManagedProfileMonitoringEndpoint}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Margin="0,0,16,8">
              <TextBlock Text="{Binding Strings[Administration.Context.Management]}" Classes="nut-metadata" />
              <TextBlock Text="{Binding ManagementModeDisplayText}" />
            </StackPanel>
            <StackPanel Margin="0,0,16,8">
              <TextBlock Text="{Binding Strings[Administration.Context.Access]}" Classes="nut-metadata" />
              <TextBlock Text="{Binding AccessModeDisplayText}" />
            </StackPanel>
            <StackPanel Margin="0,0,16,8">
              <TextBlock Text="{Binding Strings[Administration.Context.Transport]}" Classes="nut-metadata" />
              <TextBlock Text="{Binding TransportDisplayText}" />
            </StackPanel>
          </WrapPanel>
        </StackPanel>
      </Border>

      <ListBox ItemsSource="{Binding AdministrationSections}"
               SelectedItem="{Binding SelectedAdministrationSection, Mode=TwoWay}"
               HorizontalAlignment="Stretch">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="viewModels:AdministrationSectionItemViewModel">
            <StackPanel Width="220" Margin="8,6" Spacing="3">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Description}" Classes="nut-metadata" TextWrapping="Wrap" />
              <TextBlock Text="{Binding AvailabilityText}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <views:NutConfigurationAdministrationView IsVisible="{Binding IsNutConfigurationSectionSelected}" />
      <views:WindowsServiceAdministrationView IsVisible="{Binding IsWindowsServiceSectionSelected}" />
      <views:DevicesDriversAdministrationView IsVisible="{Binding IsDevicesDriversSectionSelected}" />
      <views:RemoteAccessAdministrationView IsVisible="{Binding IsRemoteAccessSectionSelected}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
