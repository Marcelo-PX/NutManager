<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets\Branding\NutManager.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Decorative illustrations loaded through avares:// URIs; no absolute or working-directory paths. -->
    <AvaloniaResource Include="Assets\**" />
      <PackageReference Include="Material.Icons.Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NutManager.Core\NutManager.Core.csproj" />
    <ProjectReference Include="..\NutManager.Infrastructure\NutManager.Infrastructure.csproj" />
  </ItemGroup>
</Project>
