<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Shared vector iconography on a 24x24 grid.
    PathIcon fills geometries and StreamGeometry uses the even-odd rule, so outlined glyphs are
    expressed as an outer subpath plus an inner subpath that punches the interior through.
    Keep new glyphs on the same grid and stroke weight (~1.6px equivalent) so scale stays uniform.
  -->

  <!-- Navigation -->
  <StreamGeometry x:Key="NutIconMenu">M3,5 L21,5 L21,7 L3,7 Z M3,11 L21,11 L21,13 L3,13 Z M3,17 L21,17 L21,19 L3,19 Z</StreamGeometry>
  <!-- Outlined house: one silhouette punched by its interior, so weight matches the other nav glyphs. -->
  <StreamGeometry x:Key="NutIconOverview">M12,3 L21.4,10.6 L21.4,20.3 A1,1 0 0 1 20.4,21.3 L14.5,21.3 L14.5,15.3 L9.5,15.3 L9.5,21.3 L3.6,21.3 A1,1 0 0 1 2.6,20.3 L2.6,10.6 Z M12,5.2 L4.4,11.4 L4.4,19.5 L7.7,19.5 L7.7,13.5 L16.3,13.5 L16.3,19.5 L19.6,19.5 L19.6,11.4 Z</StreamGeometry>
  <!-- Two rack units; the status dot sits inside the punched interior so it reads as a filled LED. -->
  <StreamGeometry x:Key="NutIconDevices">M4,3.9 L20,3.9 A1.5,1.5 0 0 1 21.5,5.4 L21.5,9.6 A1.5,1.5 0 0 1 20,11.1 L4,11.1 A1.5,1.5 0 0 1 2.5,9.6 L2.5,5.4 A1.5,1.5 0 0 1 4,3.9 Z M4.2,5.6 L4.2,9.4 L19.8,9.4 L19.8,5.6 Z M6,6.6 L11,6.6 L11,8.4 L6,8.4 Z M17.3,6.6 A0.95,0.95 0 1 1 17.29,6.6 Z M4,12.9 L20,12.9 A1.5,1.5 0 0 1 21.5,14.4 L21.5,18.6 A1.5,1.5 0 0 1 20,20.1 L4,20.1 A1.5,1.5 0 0 1 2.5,18.6 L2.5,14.4 A1.5,1.5 0 0 1 4,12.9 Z M4.2,14.6 L4.2,18.4 L19.8,18.4 L19.8,14.6 Z M6,15.6 L11,15.6 L11,17.4 L6,17.4 Z M17.3,15.6 A0.95,0.95 0 1 1 17.29,15.6 Z</StreamGeometry>
  <!-- Nonzero fill (F1) so the eight teeth union with the body instead of cancelling it. -->
  <StreamGeometry x:Key="NutIconAdministration">F1 M12,3.9 A8.1,8.1 0 1 1 11.99,3.9 Z M12,8.7 A3.3,3.3 0 1 0 12.01,8.7 Z M10.4,1.9 L13.6,1.9 L13.6,6.3 L10.4,6.3 Z M10.4,17.7 L13.6,17.7 L13.6,22.1 L10.4,22.1 Z M1.9,10.4 L6.3,10.4 L6.3,13.6 L1.9,13.6 Z M17.7,10.4 L22.1,10.4 L22.1,13.6 L17.7,13.6 Z M16.24,5.50 L18.08,3.66 L20.34,5.92 L18.50,7.76 Z M7.76,5.50 L5.92,3.66 L3.66,5.92 L5.50,7.76 Z M16.24,18.50 L18.08,20.34 L20.34,18.08 L18.50,16.24 Z M7.76,18.50 L5.92,20.34 L3.66,18.08 L5.50,16.24 Z</StreamGeometry>
  <!-- Even-weight pulse polyline built from unioned segments (F1). -->
