<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <!-- Surface hierarchy: window -> shell -> surface -> elevated -> interactive -> selected. -->
      <SolidColorBrush x:Key="NutWindowBrush" Color="#0A111B" />
      <SolidColorBrush x:Key="NutHeaderBrush" Color="#0B1522" />
      <SolidColorBrush x:Key="NutSidebarBrush" Color="#0B1522" />
      <SolidColorBrush x:Key="NutSurface1Brush" Color="#111C2B" />
      <SolidColorBrush x:Key="NutSurface2Brush" Color="#162233" />
      <SolidColorBrush x:Key="NutSurface3Brush" Color="#1B283B" />
      <SolidColorBrush x:Key="NutSurfaceHoverBrush" Color="#1E2C40" />
      <SolidColorBrush x:Key="NutSurfaceInteractiveBrush" Color="#16233A" />
      <SolidColorBrush x:Key="NutSurfaceSelectedBrush" Color="#16273F" />
      <SolidColorBrush x:Key="NutBorderBrush" Color="#24374E" />
      <SolidColorBrush x:Key="NutBorderSubtleBrush" Color="#1B2A3C" />
      <SolidColorBrush x:Key="NutBorderEmphasisBrush" Color="#33506F" />
      <SolidColorBrush x:Key="NutTextPrimaryBrush" Color="#EDF2F8" />
      <SolidColorBrush x:Key="NutTextSecondaryBrush" Color="#9AACC0" />
      <SolidColorBrush x:Key="NutTextMutedBrush" Color="#687D95" />
      <SolidColorBrush x:Key="NutSelectionBrush" Color="#16273F" />
      <SolidColorBrush x:Key="NutCodeSurfaceBrush" Color="#070D16" />
      <SolidColorBrush x:Key="NutOverlayScrimBrush" Color="#A6040910" />
      <!-- Discreet depth: card sheen and selected-row glow used sparingly by shared styles. -->
      <LinearGradientBrush x:Key="NutCardSheenBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#14223A" />
        <GradientStop Offset="1" Color="#111C2B" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="NutElevatedSheenBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#1A2A42" />
        <GradientStop Offset="1" Color="#152032" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="NutSelectedSheenBrush" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="#1D3355" />
        <GradientStop Offset="1" Color="#14243C" />
      </LinearGradientBrush>
      <!-- Compatibility aliases keep legacy T24B page surfaces on the NutManager palette. -->
      <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="#111C2B" />
      <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumLowBrush" Color="#1B283B" />
      <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#9AACC0" />
      <SolidColorBrush x:Key="SystemControlForegroundBaseMediumLowBrush" Color="#24374E" />
      <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="#16273F" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="NutWindowBrush" Color="#EEF2F8" />
      <SolidColorBrush x:Key="NutHeaderBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="NutSidebarBrush" Color="#F7F9FD" />
      <SolidColorBrush x:Key="NutSurface1Brush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="NutSurface2Brush" Color="#F7F9FD" />
      <SolidColorBrush x:Key="NutSurface3Brush" Color="#EDF2F9" />
      <SolidColorBrush x:Key="NutSurfaceHoverBrush" Color="#E4ECF9" />
      <SolidColorBrush x:Key="NutSurfaceInteractiveBrush" Color="#F2F6FC" />
      <SolidColorBrush x:Key="NutSurfaceSelectedBrush" Color="#E1EBFD" />
      <SolidColorBrush x:Key="NutBorderBrush" Color="#C6D2E2" />
      <SolidColorBrush x:Key="NutBorderSubtleBrush" Color="#DFE6F0" />
      <SolidColorBrush x:Key="NutBorderEmphasisBrush" Color="#9DB6DA" />
      <SolidColorBrush x:Key="NutTextPrimaryBrush" Color="#111C2B" />
      <SolidColorBrush x:Key="NutTextSecondaryBrush" Color="#48586C" />
      <SolidColorBrush x:Key="NutTextMutedBrush" Color="#6B7C93" />
      <SolidColorBrush x:Key="NutSelectionBrush" Color="#E1EBFD" />
      <SolidColorBrush x:Key="NutCodeSurfaceBrush" Color="#F1F5FA" />
      <SolidColorBrush x:Key="NutOverlayScrimBrush" Color="#59091426" />
      <LinearGradientBrush x:Key="NutCardSheenBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#FFFFFF" />
        <GradientStop Offset="1" Color="#F8FAFE" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="NutElevatedSheenBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#FFFFFF" />
        <GradientStop Offset="1" Color="#F2F6FC" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="NutSelectedSheenBrush" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="#DCE9FD" />
        <GradientStop Offset="1" Color="#EDF3FD" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumLowBrush" Color="#EDF2F9" />
      <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#48586C" />
      <SolidColorBrush x:Key="SystemControlForegroundBaseMediumLowBrush" Color="#C6D2E2" />
      <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="#E1EBFD" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <SolidColorBrush x:Key="NutAccentBrush" Color="#3B82F6" />
  <SolidColorBrush x:Key="NutAccentBrightBrush" Color="#60A5FA" />
  <SolidColorBrush x:Key="NutAccentSoftBrush" Color="#332F6FE0" />
  <SolidColorBrush x:Key="NutCyanBrush" Color="#38BDF8" />
  <SolidColorBrush x:Key="NutHealthyBrush" Color="#4ADE80" />
  <SolidColorBrush x:Key="NutHealthySoftBrush" Color="#2E22C55E" />
  <SolidColorBrush x:Key="NutWarningBrush" Color="#FBBF24" />
  <SolidColorBrush x:Key="NutWarningSoftBrush" Color="#2EF59E0B" />
  <SolidColorBrush x:Key="NutCriticalBrush" Color="#F87171" />
  <SolidColorBrush x:Key="NutCriticalSoftBrush" Color="#2EEF4444" />
  <SolidColorBrush x:Key="NutPurpleBrush" Color="#A78BFA" />
  <SolidColorBrush x:Key="NutFocusBrush" Color="#7DA9FF" />
  <SolidColorBrush x:Key="NutUnavailableBrush" Color="#687D95" />
  <SolidColorBrush x:Key="NutTrackBrush" Color="#33587FA8" />
</ResourceDictionary>
