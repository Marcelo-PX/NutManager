<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <!--
        Surface hierarchy: window -> shell -> surface -> elevated -> interactive -> selected.
        Surfaces stay near-neutral dark navy and lift only slightly above the window, so colour in
        the product comes from icons, metrics, status and accents rather than from card fills.
      -->
      <SolidColorBrush x:Key="NutWindowBrush" Color="#090E16" />
      <SolidColorBrush x:Key="NutHeaderBrush" Color="#0B111A" />
      <SolidColorBrush x:Key="NutSidebarBrush" Color="#0B111A" />
      <SolidColorBrush x:Key="NutSurface1Brush" Color="#0F1620" />
      <SolidColorBrush x:Key="NutSurface2Brush" Color="#121A25" />
      <SolidColorBrush x:Key="NutSurface3Brush" Color="#172029" />
      <SolidColorBrush x:Key="NutSurfaceHoverBrush" Color="#1B2531" />
      <SolidColorBrush x:Key="NutSurfaceInteractiveBrush" Color="#131B26" />
      <SolidColorBrush x:Key="NutSurfaceSelectedBrush" Color="#14202F" />
      <!-- Translucent panel tint: glass over the page, not another opaque card. -->
      <SolidColorBrush x:Key="NutGlassSurfaceBrush" Color="#E6121A25" />
      <SolidColorBrush x:Key="NutBorderBrush" Color="#222C3B" />
      <SolidColorBrush x:Key="NutBorderSubtleBrush" Color="#1A2230" />
      <SolidColorBrush x:Key="NutBorderEmphasisBrush" Color="#2E3D50" />
      <SolidColorBrush x:Key="NutTextPrimaryBrush" Color="#EDF2F8" />
      <SolidColorBrush x:Key="NutTextSecondaryBrush" Color="#9AACC0" />
      <SolidColorBrush x:Key="NutTextMutedBrush" Color="#687D95" />
      <SolidColorBrush x:Key="NutSelectionBrush" Color="#14202F" />
      <SolidColorBrush x:Key="NutCodeSurfaceBrush" Color="#070B12" />
      <SolidColorBrush x:Key="NutOverlayScrimBrush" Color="#A6040910" />
      <!-- Discreet depth: card sheen and selected-row glow used sparingly by shared styles. -->
      <LinearGradientBrush x:Key="NutCardSheenBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#111823" />
        <GradientStop Offset="1" Color="#0E141D" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="NutElevatedSheenBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#141C27" />
        <GradientStop Offset="1" Color="#101720" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="NutSelectedSheenBrush" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="#16243A" />
        <GradientStop Offset="1" Color="#111A26" />
      </LinearGradientBrush>
      <!-- Compatibility aliases keep legacy T24B page surfaces on the NutManager palette. -->
      <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="#0F1620" />
      <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumLowBrush" Color="#172029" />
      <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#9AACC0" />
      <SolidColorBrush x:Key="SystemControlForegroundBaseMediumLowBrush" Color="#222C3B" />
      <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="#14202F" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="NutWindowBrush" Color="#EEF2F8" />
      <SolidColorBrush x:Key="NutHeaderBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="NutSidebarBrush" Color="#F7F9FD" />
      <SolidColorBrush x:Key="NutSurface1Brush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="NutSurface2Brush" Color="#F7F9FD" />
      <SolidColorBrush x:Key="NutSurface3Brush" Color="#EDF2F9" />
      <SolidColorBrush x:Key="NutGlassSurfaceBrush" Color="#E6F7F9FD" />
      <SolidColorBrush x:Key="NutSurfaceHoverBrush" Color="#E4ECF9" />
      <SolidColorBrush x:Key="NutSurfaceInteractiveBrush" Color="#F2F6FC" />
      <SolidColorBrush x:Key="NutSurfaceSelectedBrush" Color="#E1EBFD" />
      <SolidColorBrush x:Key="NutBorderBrush" Color="#C6D2E2" />
      <SolidColorBrush x:Key="NutBorderSubtleBrush" Color="#DFE6F0" />
      <SolidColorBrush x:Key="NutBorderEmphasisBrush" Color="#9DB6DA" />
      <SolidColorBrush x:Key="NutTextPrimaryBrush" Color="#111C2B" />
      <SolidColorBrush x:Key="NutTextSecondaryBrush" Color="#48586C" />
      <SolidColorBrush x:Key="NutTextMutedBrush" Color="#6B7C93" />
      <SolidColorBrush x:Key="NutSelectionBrush" Color="#E1EBFD" />
      <SolidColorBrush x:Key="NutCodeSurfaceBrush" Color="#F1F5FA" />
      <SolidColorBrush x:Key="NutOverlayScrimBrush" Color="#59091426" />
      <LinearGradientBrush x:Key="NutCardSheenBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#FFFFFF" />
        <GradientStop Offset="1" Color="#F8FAFE" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="NutElevatedSheenBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#FFFFFF" />
        <GradientStop Offset="1" Color="#F2F6FC" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="NutSelectedSheenBrush" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="#DCE9FD" />
        <GradientStop Offset="1" Color="#EDF3FD" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumLowBrush" Color="#EDF2F9" />
      <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#48586C" />
      <SolidColorBrush x:Key="SystemControlForegroundBaseMediumLowBrush" Color="#C6D2E2" />
      <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="#E1EBFD" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <SolidColorBrush x:Key="NutAccentBrush" Color="#3B82F6" />
  <SolidColorBrush x:Key="NutAccentBrightBrush" Color="#60A5FA" />
  <SolidColorBrush x:Key="NutOnAccentBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="NutAccentSoftBrush" Color="#332F6FE0" />
  <SolidColorBrush x:Key="NutCyanBrush" Color="#38BDF8" />
  <SolidColorBrush x:Key="NutHealthyBrush" Color="#4ADE80" />
  <SolidColorBrush x:Key="NutHealthySoftBrush" Color="#2E22C55E" />
  <SolidColorBrush x:Key="NutWarningBrush" Color="#FBBF24" />
  <SolidColorBrush x:Key="NutWarningSoftBrush" Color="#2EF59E0B" />
  <SolidColorBrush x:Key="NutCriticalBrush" Color="#F87171" />
  <SolidColorBrush x:Key="NutCriticalSoftBrush" Color="#2EEF4444" />
  <!--
    Hover pairs for the semantic badges. The soft fills are alpha over whatever surface is behind
    them, so one definition reads correctly in both themes; the bright borders are the same hues
    lifted a step, which keeps a hovered badge unmistakably the same state it was.
  -->
  <SolidColorBrush x:Key="NutAccentSoftHoverBrush" Color="#4D2F6FE0" />
  <SolidColorBrush x:Key="NutHealthyBrightBrush" Color="#86EFAC" />
  <SolidColorBrush x:Key="NutHealthySoftHoverBrush" Color="#4D22C55E" />
  <SolidColorBrush x:Key="NutWarningBrightBrush" Color="#FCD34D" />
  <SolidColorBrush x:Key="NutWarningSoftHoverBrush" Color="#4DF59E0B" />
  <SolidColorBrush x:Key="NutCriticalBrightBrush" Color="#FCA5A5" />
  <SolidColorBrush x:Key="NutCriticalSoftHoverBrush" Color="#4DEF4444" />

  <!--
    The status light's own green. It is a step brighter and more saturated than NutHealthyBrush so a
    small lit ball still reads as lit; the shared healthy token stays where it is because it also
    colours badge text and borders, where the same lift would look garish rather than luminous.
  -->
  <SolidColorBrush x:Key="NutLedHealthyBrush" Color="#3BEF88" />

  <SolidColorBrush x:Key="NutPurpleBrush" Color="#A78BFA" />
  <SolidColorBrush x:Key="NutFocusBrush" Color="#7DA9FF" />
  <SolidColorBrush x:Key="NutUnavailableBrush" Color="#687D95" />
  <SolidColorBrush x:Key="NutTrackBrush" Color="#2A3441" />
  <SolidColorBrush x:Key="NutGaugeTrackBrush" Color="#3A4757" />
</ResourceDictionary>
