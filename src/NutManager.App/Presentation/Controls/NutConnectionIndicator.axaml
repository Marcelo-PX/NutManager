<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NutManager.App.Presentation.Controls"
             x:Class="NutManager.App.Presentation.Controls.NutConnectionIndicator"
             x:Name="Root">
  <Grid ColumnDefinitions="Auto,*"
        ColumnSpacing="4"
        VerticalAlignment="Center"
        ClipToBounds="True"
        ToolTip.Tip="{Binding AccessibleText, ElementName=Root}"
        AutomationProperties.Name="{Binding AccessibleText, ElementName=Root}">
    <controls:NutStatusLed Grid.Column="0" State="{Binding LedState, ElementName=Root}" />
    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" ClipToBounds="True">
      <TextBlock Text="{Binding StatusText, ElementName=Root}" Classes="nut-product-title" TextTrimming="CharacterEllipsis" />
      <StackPanel Orientation="Horizontal" Spacing="6" ClipToBounds="True">
        <TextBlock Text="{Binding StateText, ElementName=Root}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{Binding StateBrush, ElementName=Root}"
                   TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding HasStateText, ElementName=Root}" />
        <TextBlock Text="•" Classes="nut-metadata" IsVisible="{Binding HasStateText, ElementName=Root}" />
        <TextBlock Text="{Binding DetailText, ElementName=Root}" Classes="nut-metadata" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
