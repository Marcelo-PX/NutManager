<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NutManager.App.Presentation.Controls.NutStatusBadge"
             x:Name="Root">
  <Grid>
    <Border Padding="9,4" CornerRadius="12" Background="{DynamicResource NutHealthyBrush}" Opacity="0.2" IsVisible="{Binding IsHealthy, ElementName=Root}" />
    <Border Padding="9,4" CornerRadius="12" Background="{DynamicResource NutWarningBrush}" Opacity="0.2" IsVisible="{Binding IsWarning, ElementName=Root}" />
    <Border Padding="9,4" CornerRadius="12" Background="{DynamicResource NutCriticalBrush}" Opacity="0.2" IsVisible="{Binding IsCritical, ElementName=Root}" />
    <Border Padding="9,4" CornerRadius="12" Background="{DynamicResource NutUnavailableBrush}" Opacity="0.2" IsVisible="{Binding IsUnavailable, ElementName=Root}" />
    <TextBlock Text="{Binding Text, ElementName=Root}" Margin="9,4" FontSize="12" FontWeight="SemiBold" />
  </Grid>
</UserControl>
