<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shapes="clr-namespace:Avalonia.Controls.Shapes;assembly=Avalonia.Controls"
             x:Class="NutManager.App.Presentation.Controls.NutNavigationIcon"
             x:Name="Root"
             Width="24"
             Height="24">
  <!--
    One glyph per navigation destination, drawn by the icon library.

    Each kind used to be several shapes stacked in this box so that one piece could move while the
    rest held still: two LEDs blinking out of phase, a hub sitting motionless inside a turning gear,
    a reading travelling along a pulse trace. The library gives one silhouette per name, so the
    motion moved up a level — the glyph itself carries it now, and the Grid around it still supplies
    the family's hover transform, which is why the two are still separate elements.

    Path with Stretch="None" rather than PathIcon: the library draws on the same 24x24 grid these
    were authored on, so rendering at native coordinates keeps the size and weight the sidebar
    already had. It also keeps the glyph clear of the generic "Button PathIcon" opacity rules, whose
    hover transition would run against the compositor animations below on the same property.
  -->
  <Grid Width="24" Height="24">

    <!-- Overview: the dashboard breathes, the way a surface with live figures on it would. -->
    <Grid Classes="nut-icon-motion nut-icon-lift" IsVisible="{Binding IsOverview, ElementName=Root}">
      <shapes:Path x:Name="OverviewGlyph" Classes="nut-nav-glyph" Stretch="None" Data="{DynamicResource NutIconOverview}" />
    </Grid>

    <!-- Devices: a slow rise and fall in place of the two rack lights that used to blink. -->
    <Grid Classes="nut-icon-motion nut-icon-nudge" IsVisible="{Binding IsDevices, ElementName=Root}">
      <shapes:Path x:Name="DevicesGlyph" Classes="nut-nav-glyph" Stretch="None" Data="{DynamicResource NutIconDevices}" />
    </Grid>

    <!-- Administration: one pop on arrival, which is what the verified badge used to do. -->
    <Grid Classes="nut-icon-motion nut-icon-lift" IsVisible="{Binding IsAdministration, ElementName=Root}">
      <shapes:Path x:Name="AdministrationGlyph" Classes="nut-nav-glyph" Stretch="None" Data="{DynamicResource NutIconAdministration}" />
    </Grid>

    <!-- Diagnostics: the trace beats, rather than a dot running along it. -->
    <Grid Classes="nut-icon-motion nut-icon-lift" IsVisible="{Binding IsDiagnostics, ElementName=Root}">
      <shapes:Path x:Name="DiagnosticsGlyph" Classes="nut-nav-glyph" Stretch="None" Data="{DynamicResource NutIconDiagnostics}" />
    </Grid>

    <!-- Settings: the whole cog turns, where before the teeth turned around a fixed hub. -->
    <Grid Classes="nut-icon-motion nut-icon-gear" IsVisible="{Binding IsSettings, ElementName=Root}">
      <shapes:Path x:Name="SettingsGlyph" Classes="nut-nav-glyph" Stretch="None" Data="{DynamicResource NutIconSettings}" />
    </Grid>
  </Grid>
</UserControl>
