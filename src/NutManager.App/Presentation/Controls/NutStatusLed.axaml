<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NutManager.App.Presentation.Controls.NutStatusLed"
             x:Name="Root"
             Width="32"
             Height="32"
             ClipToBounds="False">
  <!--
    One solid ball with two blurred shadows. The ambient shadow keeps the current state legible at
    every point in the cycle; the second shadow expands outwards and disappears like a soft light
    wave. The core never fades or moves, and intentionally has no white lens highlight.

    A shadow colour cannot come from a brush binding, so each state carries its own class. The halo
    is a bare border with no fill - only its strongly blurred shadow is ever visible. The wave uses
    a small spread so its leading edge remains luminous while opacity falls during expansion. Both
    scale and opacity run on the render thread through the Composition API, with no UI timer.

    Sizes are even numbers inside an even cell so every layer centres on a whole pixel. A
    fractional size leaves the circle straddling a half pixel and the antialiasing comes out
    heavier on one side, which at this diameter reads as the ball sitting crooked.

    The cell stays 32px for an 8px ball and every layer opts out of clipping, allowing the expanded
    blur to dissipate naturally instead of being cut into a square. The extra width is empty space,
    not a larger indicator.

    Colour and animation are decorative; the state is always spelled out in the adjacent text and
    in the accessible name.
  -->
  <UserControl.Styles>
    <Style Selector="Border.nut-led-halo">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="Border.nut-led-halo.healthy">
      <!-- Matches NutLedHealthyBrush; a shadow colour cannot be bound to a resource. -->
      <Setter Property="BoxShadow" Value="0 0 12 1 #F23BEF88" />
    </Style>
    <Style Selector="Border.nut-led-halo.pending">
      <Setter Property="BoxShadow" Value="0 0 12 1 #F2FBBF24" />
    </Style>
    <Style Selector="Border.nut-led-halo.critical">
      <Setter Property="BoxShadow" Value="0 0 15 2 #F2F87171" />
    </Style>
  </UserControl.Styles>

  <Grid Width="32" Height="32" Background="Transparent" ClipToBounds="False">
    <Border x:Name="AmbientHalo"
            Classes="nut-led-halo"
            Width="6"
            Height="6"
            Opacity="0.76"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsHitTestVisible="False" />
    <Border x:Name="Halo"
            Classes="nut-led-halo"
            Width="6"
            Height="6"
            Opacity="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsHitTestVisible="False" />
    <Ellipse x:Name="Core"
             Width="8"
             Height="8"
             Fill="{Binding StateBrush, ElementName=Root}"
             HorizontalAlignment="Center"
             VerticalAlignment="Center" />
  </Grid>
</UserControl>
